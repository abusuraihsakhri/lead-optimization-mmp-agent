{
  "openapi": "3.1.0",
  "info": {
    "title": "Lead Optimization MMP Agent — Generic Audit API",
    "description": "Generic deterministic threshold checks; does not identify chemical matched pairs or predict potency. Runtime OpenAPI at /openapi.json is authoritative.",
    "version": "3.0.1"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Serve local browser interface",
        "responses": {
          "200": {
            "description": "HTML application"
          },
          "404": {
            "description": "Web file not bundled"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Verify service and HMAC configuration",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Signing key not configured"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory operational counters in JSON",
        "responses": {
          "200": {
            "description": "JSON counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate generic numerical thresholds",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SystemTaskPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deterministic dossier"
          },
          "400": {
            "description": "Submitted identifier matched a sensitive-data pattern"
          },
          "422": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock status response only",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock response"
          },
          "400": {
            "description": "Pattern-flagged sensitive identifier"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read in-memory audit chain when optional token is configured",
        "parameters": [
          {
            "name": "X-Audit-Token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit records and integrity status"
          },
          "403": {
            "description": "Invalid read token"
          },
          "404": {
            "description": "Log endpoint disabled"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SystemTaskPayload": {
        "type": "object",
        "required": [
          "task_id",
          "target_identifier",
          "primary_metric"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "target_identifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "primary_metric": {
            "type": "number"
          },
          "secondary_metric": {
            "type": "number",
            "default": 0
          },
          "status_descriptor": {
            "type": "string",
            "default": "NOMINAL",
            "maxLength": 64
          },
          "is_critical_flag": {
            "type": "boolean",
            "default": false
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    }
  }
}
